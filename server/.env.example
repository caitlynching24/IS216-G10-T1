# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000

# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/petsociety
# MongoDB Atlas:
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/petsociety?retryWrites=true&w=majority

# Comma-separated list of origins allowed to call this API (the Vite dev server, by default)
CLIENT_ORIGIN=http://localhost:5173
